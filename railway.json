{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "preDeployCommand": "python manage.py migrate && python seed_data.py",
    "startCommand": "python manage.py collectstatic --noinput && gunicorn turf.wsgi:application --bind 0.0.0.0:$PORT --log-file -",
    "healthcheckPath": "/",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
